{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://capital-intelligence.local/schemas/paper-trading-launch-evidence.v1.json",
  "title": "Paper Trading Launch Evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "identifier",
    "observed_at",
    "knowledge_cutoff",
    "window_start",
    "window_end",
    "baseline_identifier",
    "process_version",
    "code_version",
    "portfolio_count",
    "portfolio_code",
    "starting_capital",
    "base_currency",
    "paper_only_disclosures_verified",
    "live_broker_credentials_present",
    "canonical_portfolio_integrity_verified",
    "eligible_universe_integrity_verified",
    "execution_store_integrity_verified",
    "scheduled_cycles",
    "successful_cycles",
    "point_in_time_cycles",
    "complete_universe_cycles",
    "required_provider_checks",
    "successful_required_provider_checks",
    "shadow_execution_scenarios",
    "reconciled_shadow_execution_scenarios",
    "execution_cost_error_bps",
    "unresolved_orders",
    "duplicate_fill_events",
    "negative_cash_events",
    "stale_quote_acceptances",
    "unresolved_critical_incidents",
    "data_integrity_failures",
    "reconciliation_failures",
    "backup_restore_exercises",
    "scheduler_replay_exercises",
    "kill_switch_exercises",
    "provider_failover_exercises",
    "market_session_exercises",
    "partial_fill_retry_exercises",
    "corporate_action_replay_exercises",
    "fx_revaluation_exercises",
    "production_binding_approval_identifier",
    "recovery_certification_identifier",
    "execution_calibration_identifier",
    "execution_policy_version",
    "data_readiness_identifier",
    "product_readiness_identifier",
    "evidence_identifiers",
    "source_identifiers"
  ],
  "properties": {
    "identifier": {"type": "string", "minLength": 1},
    "observed_at": {"type": "string", "format": "date-time"},
    "knowledge_cutoff": {"type": "string", "format": "date-time"},
    "window_start": {"type": "string", "format": "date-time"},
    "window_end": {"type": "string", "format": "date-time"},
    "baseline_identifier": {"type": "string", "minLength": 1},
    "process_version": {"type": "string", "minLength": 1},
    "code_version": {"type": "string", "minLength": 1},
    "portfolio_count": {"type": "integer", "minimum": 0},
    "portfolio_code": {"type": "string", "minLength": 1},
    "starting_capital": {"type": "number", "exclusiveMinimum": 0},
    "base_currency": {"type": "string", "minLength": 3},
    "paper_only_disclosures_verified": {"type": "boolean"},
    "live_broker_credentials_present": {"type": "boolean"},
    "canonical_portfolio_integrity_verified": {"type": "boolean"},
    "eligible_universe_integrity_verified": {"type": "boolean"},
    "execution_store_integrity_verified": {"type": "boolean"},
    "scheduled_cycles": {"$ref": "#/$defs/count"},
    "successful_cycles": {"$ref": "#/$defs/count"},
    "point_in_time_cycles": {"$ref": "#/$defs/count"},
    "complete_universe_cycles": {"$ref": "#/$defs/count"},
    "required_provider_checks": {"$ref": "#/$defs/count"},
    "successful_required_provider_checks": {"$ref": "#/$defs/count"},
    "shadow_execution_scenarios": {"$ref": "#/$defs/count"},
    "reconciled_shadow_execution_scenarios": {"$ref": "#/$defs/count"},
    "execution_cost_error_bps": {"type": "number", "minimum": 0},
    "unresolved_orders": {"$ref": "#/$defs/count"},
    "duplicate_fill_events": {"$ref": "#/$defs/count"},
    "negative_cash_events": {"$ref": "#/$defs/count"},
    "stale_quote_acceptances": {"$ref": "#/$defs/count"},
    "unresolved_critical_incidents": {"$ref": "#/$defs/count"},
    "data_integrity_failures": {"$ref": "#/$defs/count"},
    "reconciliation_failures": {"$ref": "#/$defs/count"},
    "backup_restore_exercises": {"$ref": "#/$defs/count"},
    "scheduler_replay_exercises": {"$ref": "#/$defs/count"},
    "kill_switch_exercises": {"$ref": "#/$defs/count"},
    "provider_failover_exercises": {"$ref": "#/$defs/count"},
    "market_session_exercises": {"$ref": "#/$defs/count"},
    "partial_fill_retry_exercises": {"$ref": "#/$defs/count"},
    "corporate_action_replay_exercises": {"$ref": "#/$defs/count"},
    "fx_revaluation_exercises": {"$ref": "#/$defs/count"},
    "production_binding_approval_identifier": {"type": "string", "minLength": 1},
    "recovery_certification_identifier": {"type": "string", "minLength": 1},
    "execution_calibration_identifier": {"type": "string", "minLength": 1},
    "execution_policy_version": {"type": "string", "minLength": 1},
    "data_readiness_identifier": {"type": "string", "minLength": 1},
    "product_readiness_identifier": {"type": "string", "minLength": 1},
    "evidence_identifiers": {"$ref": "#/$defs/identifiers"},
    "source_identifiers": {"$ref": "#/$defs/identifiers"},
    "schema_version": {
      "const": "paper-trading-launch-evidence.v1"
    }
  },
  "$defs": {
    "count": {"type": "integer", "minimum": 0},
    "identifiers": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    }
  }
}
