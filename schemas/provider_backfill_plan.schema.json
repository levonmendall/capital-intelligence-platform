{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://capital-intelligence.local/schemas/provider_backfill_plan.schema.json",
  "title": "Provider Backfill Plan",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "identifier", "as_of", "tasks"],
  "properties": {
    "schema_version": {"const": "provider-backfill-plan.v1"},
    "identifier": {"type": "string", "minLength": 1},
    "as_of": {"type": "string", "format": "date-time"},
    "tasks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["identifier", "provider_factory", "dataset_type", "provider_symbols", "start_at", "end_at"],
        "properties": {
          "identifier": {"type": "string", "minLength": 1},
          "provider_factory": {"type": "string", "pattern": "^[^:]+:[^:]+$"},
          "dataset_type": {"enum": ["account_entitlement", "exchange_directory", "symbol_directory", "fundamentals", "fixed_income", "commodity", "market_history", "corporate_actions"]},
          "provider_symbols": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "start_at": {"type": "string", "format": "date-time"},
          "end_at": {"type": "string", "format": "date-time"},
          "window_days": {"type": "integer", "minimum": 1, "maximum": 3660},
          "limit": {"type": "integer", "minimum": 1, "maximum": 1000000},
          "required": {"type": "boolean"}
        }
      }
    }
  }
}
