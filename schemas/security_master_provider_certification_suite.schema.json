{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://capital-intelligence.local/schemas/security_master_provider_certification_suite.schema.json",
  "title": "Security Master Provider Certification Suite",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": ["identifier", "kind", "description", "query"],
    "properties": {
      "identifier": {"type": "string", "minLength": 1},
      "kind": {
        "enum": [
          "current_identity",
          "historical_identity",
          "symbol_change",
          "venue_change",
          "delisting",
          "merger",
          "spinoff",
          "late_correction",
          "future_knowledge_exclusion",
          "cross_venue_adjustment",
          "full_universe_coverage"
        ]
      },
      "description": {"type": "string", "minLength": 1},
      "required": {"type": "boolean", "default": true},
      "query": {
        "type": "object",
        "additionalProperties": false,
        "required": ["identifier", "as_of", "knowledge_cutoff", "requested_at"],
        "properties": {
          "identifier": {"type": "string", "minLength": 1},
          "as_of": {"type": "string", "format": "date-time"},
          "knowledge_cutoff": {"type": "string", "format": "date-time"},
          "requested_at": {"type": "string", "format": "date-time"}
        }
      },
      "expected_symbols": {"type": "array", "items": {"type": "string", "minLength": 1}},
      "excluded_symbols": {"type": "array", "items": {"type": "string", "minLength": 1}},
      "expected_listings": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": ["symbol", "venue", "status"],
          "properties": {
            "symbol": {"type": "string", "minLength": 1},
            "venue": {"type": "string", "minLength": 1},
            "status": {"enum": ["active", "suspended", "delisted"]}
          }
        }
      },
      "expected_action_types": {
        "type": "array",
        "items": {
          "enum": ["symbol_change", "venue_change", "relisting", "delisting", "merger", "spinoff", "other"]
        }
      },
      "minimum_instrument_count": {"type": "integer", "minimum": 0},
      "maximum_future_known_records": {"type": "integer", "minimum": 0}
    }
  }
}
