{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://capital-intelligence.local/schemas/security_master_provider_manifest.schema.json",
  "title": "Security Master Provider Capability Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "provider",
    "product",
    "manifest_version",
    "source_version",
    "license_reference",
    "license_verified",
    "complete_eligible_universe",
    "point_in_time_delivery",
    "historical_identifiers",
    "listing_and_venue_history",
    "delisted_securities",
    "corporate_actions",
    "revision_history",
    "provenance_complete",
    "cross_venue_adjustment_policy",
    "service_level_reference",
    "maximum_delivery_age_hours",
    "valid_from",
    "valid_until"
  ],
  "properties": {
    "provider": {"type": "string", "minLength": 1},
    "product": {"type": "string", "minLength": 1},
    "manifest_version": {"type": "string", "minLength": 1},
    "source_version": {"type": "string", "minLength": 1},
    "license_reference": {"type": "string", "minLength": 1},
    "license_verified": {"type": "boolean"},
    "complete_eligible_universe": {"type": "boolean"},
    "point_in_time_delivery": {"type": "boolean"},
    "historical_identifiers": {"type": "boolean"},
    "listing_and_venue_history": {"type": "boolean"},
    "delisted_securities": {"type": "boolean"},
    "corporate_actions": {"type": "boolean"},
    "revision_history": {"type": "boolean"},
    "provenance_complete": {"type": "boolean"},
    "cross_venue_adjustment_policy": {"type": "string", "minLength": 1},
    "service_level_reference": {"type": "string", "minLength": 1},
    "maximum_delivery_age_hours": {"type": "number", "minimum": 0},
    "valid_from": {"type": "string", "format": "date-time"},
    "valid_until": {"type": "string", "format": "date-time"}
  }
}
