{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://capital-intelligence.local/schemas/execution-calibration-input.v1.json",
  "title": "Paper Execution Calibration Input",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "identifier",
    "execution_policy_version",
    "samples",
    "schema_version"
  ],
  "properties": {
    "identifier": {"type": "string", "minLength": 1},
    "execution_policy_version": {"type": "string", "minLength": 1},
    "samples": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "identifier",
          "instrument_identifier",
          "asset_class",
          "venue",
          "provider",
          "observed_at",
          "modeled_at",
          "side",
          "bid",
          "ask",
          "benchmark_fill_price",
          "modeled_fill_price",
          "source_identifier"
        ],
        "properties": {
          "identifier": {"type": "string", "minLength": 1},
          "instrument_identifier": {"type": "string", "minLength": 1},
          "asset_class": {"type": "string", "minLength": 1},
          "venue": {"type": "string", "minLength": 1},
          "provider": {"type": "string", "minLength": 1},
          "observed_at": {"type": "string", "format": "date-time"},
          "modeled_at": {"type": "string", "format": "date-time"},
          "side": {"enum": ["buy", "sell"]},
          "bid": {"type": "number", "exclusiveMinimum": 0},
          "ask": {"type": "number", "exclusiveMinimum": 0},
          "benchmark_fill_price": {"type": "number", "exclusiveMinimum": 0},
          "modeled_fill_price": {"type": "number", "exclusiveMinimum": 0},
          "source_identifier": {"type": "string", "minLength": 1}
        }
      }
    },
    "schema_version": {"const": "paper-execution-calibration-input.v1"}
  }
}
