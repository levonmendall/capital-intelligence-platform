path = Path("premium_ui.py")
source = path.read_text(encoding="utf-8")
quiet = "The interface stays quiet until evidence earns attention."
if quiet not in source:
    anchor = "A continuously operating decision system for one governed portfolio."
    if anchor not in source:
        raise SystemExit("premium UI quiet-copy anchor is unavailable")
    source = source.replace(anchor, f"{anchor} {quiet}", 1)
path.write_text(source, encoding="utf-8")

path = Path(".github/workflows/free-paper-pilot-readiness.yml")
