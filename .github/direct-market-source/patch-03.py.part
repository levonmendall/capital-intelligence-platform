anchor = "      - 'operations/free_paper_pilot.py'\n"
if anchor in source and "operations/direct_global_markets.py" not in source:
    source = source.replace(anchor, anchor + "      - 'operations/direct_global_markets.py'\n      - 'config/direct_global_market_universe.json'\n", 1)
