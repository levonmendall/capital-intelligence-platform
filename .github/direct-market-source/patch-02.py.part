
path = Path("config/free_paper_pilot_universe.json")
payload = json.loads(path.read_text(encoding="utf-8"))
payload.pop("direct_instrument_classes_prohibited", None)
payload["objective"] = (
    "Provide liquid U.S.-listed implementation alternatives while direct spot FX, "
    "direct spot crypto, and fully collateralized futures compete in the same "
    "canonical paper portfolio through the direct-market universe."
)
payload["limitations"] = [
    item for item in payload.get("limitations", [])
    if "does not certify direct trading" not in str(item)
]
payload["limitations"].append(
    "Listed wrappers remain implementation alternatives rather than substitutes for direct-market analysis."
)
path.write_text(json.dumps(payload, indent=2) + "\n", encoding="utf-8")

path = Path("production_context_publication_governed.py")
source = path.read_text(encoding="utf-8")
source = replace_once(
    source,
    '''from operations.equity_discovery import (
    EquityDiscoveryResult,
    discover_us_equities,
)
''',
    '''from operations.direct_global_markets import load_direct_global_market_universe
from operations.equity_discovery import (
    EquityDiscoveryResult,
    discover_us_equities,
)
''',
    "direct universe import",
)
source = replace_once(
    source,
    '''        discovered = discovery.instruments_for_holdings(held_symbols)
        universe = replace(
            base_universe,
            identifier=f"{base_universe.identifier}+{discovery.identifier}",
''',
    '''        discovered = discovery.instruments_for_holdings(held_symbols)
        direct_universe = load_direct_global_market_universe()
        universe = replace(
            base_universe,
            identifier=(
                f"{base_universe.identifier}+{discovery.identifier}"
                f"+{direct_universe.identifier}"
            ),
''',
    "direct universe load",
)
source = replace_once(
    source,
    '''            instruments=tuple((*base_universe.instruments, *discovered)),
''',
    '''            instruments=tuple((*base_universe.instruments, *discovered, *direct_universe.instruments)),
''',
    "direct universe instruments",
)
source = replace_once(
    source,
    '''                     "Individual equities enter through broad SEC/Alpaca discovery and begin with a 1% exploratory cap.")
''',
    '''                     "Individual equities enter through broad SEC/Alpaca discovery and begin with a 1% exploratory cap.",
                     *direct_universe.limitations)
''',
    "direct limitations",
)
