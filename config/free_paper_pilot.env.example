# Copy credentials into the runtime secret store. Never commit real values.
# Canonical Alpaca names:
APCA_API_KEY_ID=replace-with-alpaca-paper-key
APCA_API_SECRET_KEY=replace-with-alpaca-paper-secret
# The runtime and GitHub workflow also accept ALPACA_API_KEY_ID / ALPACA_API_KEY
# and ALPACA_API_SECRET_KEY / ALPACA_SECRET_KEY / ALPACA_API_SECRET.
APCA_API_BASE_URL=https://paper-api.alpaca.markets
APCA_DATA_BASE_URL=https://data.alpaca.markets
APCA_DATA_FEED=iex
CAPITAL_INTELLIGENCE_ENVIRONMENT=development

# Existing canonical database locations may be overridden when required.
CAPITAL_INTELLIGENCE_DATA_DIR=database
CAPITAL_INTELLIGENCE_CANONICAL_PORTFOLIO_DATABASE=database/canonical_portfolio.db
CAPITAL_INTELLIGENCE_ELIGIBLE_UNIVERSE_DATABASE=database/eligible_universe.db
CAPITAL_INTELLIGENCE_MULTI_ASSET_EXECUTION_DATABASE=database/multi_asset_paper_execution.db
CAPITAL_INTELLIGENCE_PAPER_TEST_GOVERNANCE_DATABASE=database/paper_test_governance.db
CAPITAL_INTELLIGENCE_ALERT_DATABASE=database/alerts.db
