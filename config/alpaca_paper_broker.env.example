# Paper credentials only. The adapter rejects https://api.alpaca.markets.
APCA_API_KEY_ID=inject-from-secret-manager
APCA_API_SECRET_KEY=inject-from-secret-manager
APCA_API_BASE_URL=https://paper-api.alpaca.markets
APCA_DATA_BASE_URL=https://data.alpaca.markets
APCA_DATA_FEED=iex

# Append-only governance and broker evidence.
CAPITAL_INTELLIGENCE_PROVIDER_ACTIVATION_DATABASE=database/provider_activations.db
CAPITAL_INTELLIGENCE_ALPACA_PAPER_BROKER_DATABASE=database/alpaca_paper_broker.db

# The free broker pilot remains paper-only.
CAPITAL_INTELLIGENCE_ENVIRONMENT=development
