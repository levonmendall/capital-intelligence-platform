      "required": true,
      "credential_environment_variables": [],
      "parameters": {
        "query": "(economy OR markets OR stocks OR bonds OR oil OR inflation OR central bank OR earnings OR commodities OR sanctions OR conflict OR ceasefire OR trade OR cyber OR weather)",
