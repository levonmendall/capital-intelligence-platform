        "format": "json",
        "maxrecords": 250,
        "sort": "HybridRel",
        "timespan": "24h"
      },
      "headers": {},
      "maximum_records": 250,
      "domains": [
        "current_events_news",
        "geopolitical_security",
        "government_policy_regulation",
        "public_health",
        "cybersecurity_incidents",
        "supply_chain_shipping_inventories",
        "weather_climate_disasters",
        "social_search_sentiment"
      ],
      "impact_channels": [
        "growth",
        "inflation",
        "policy",
        "earnings",
        "credit",
        "supply",
        "demand",
        "commodity",
        "currency",
        "volatility",
        "regulation",
        "geopolitical",
        "cyber",
        "climate_weather",
        "sentiment"
      ],
      "reliability": 0.55,
      "relevance": 0.7,
      "materiality": 0.45,
      "license_identifier": "GDELT-public-api-metadata",
      "usage_rights_identifier": "metadata-and-links-only.no-article-body-storage",
      "limitations": [
        "Discovery metadata only; article text is not copied or stored.",
        "Must be corroborated by an original or independently licensed source before CIO reliance."
