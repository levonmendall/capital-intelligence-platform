{
  "identifier": "public-live-information-sources.v1",
  "sources": [
    {
      "identifier": "gdelt-global-news-discovery",
      "source_name": "GDELT DOC 2.0 news discovery metadata",
      "parser": "gdelt_doc",
      "endpoint": "https://api.gdeltproject.org/api/v2/doc/doc",
      "source_type": "alternative",
      "independence_group": "gdelt-news-discovery",
      "enabled": true,
      "required": true,
      "credential_environment_variables": [],
      "parameters": {
        "query": "(economy OR markets OR inflation OR central bank OR earnings OR commodities OR sanctions OR conflict OR cyber OR weather)",
        "mode": "artlist",
        "format": "json",
        "maxrecords": 250,
        "sort": "HybridRel",
        "timespan": "1h"
      },
      "headers": {},
      "maximum_records": 250,
      "domains": ["current_events_news", "geopolitical_security", "government_policy_regulation", "public_health", "cybersecurity_incidents", "supply_chain_shipping_inventories", "weather_climate_disasters", "social_search_sentiment"],
      "impact_channels": ["growth", "inflation", "policy", "earnings", "credit", "supply", "demand", "commodity", "currency", "volatility", "regulation", "geopolitical", "cyber", "climate_weather", "sentiment"],
      "reliability": 0.55,
      "relevance": 0.7,
      "materiality": 0.45,
      "license_identifier": "GDELT-public-api-metadata",
      "usage_rights_identifier": "metadata-and-links-only.no-article-body-storage",
      "limitations": ["Discovery metadata only; article text is not copied or stored.", "Must be corroborated by an original or independently licensed source before CIO reliance."]
    },
    {
