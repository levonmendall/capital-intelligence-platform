    {
      "identifier": "cftc-positioning-live",
      "source_name": "CFTC Disaggregated Commitments of Traders",
      "parser": "cftc_socrata",
      "endpoint": "https://publicreporting.cftc.gov/resource/72hh-3qpy.json",
      "source_type": "regulatory",
      "independence_group": "cftc-public-reporting",
      "enabled": true,
      "required": true,
      "credential_environment_variables": [],
      "parameters": {"$limit": 500, "$order": "report_date_as_yyyy_mm_dd DESC"},
      "headers": {"Accept": "application/json"},
      "maximum_records": 500,
      "domains": ["futures_positioning", "commodity_physical_balances", "fund_flows_positioning"],
      "impact_channels": ["commodity", "currency", "volatility", "positioning", "sentiment"],
      "reliability": 0.98,
      "relevance": 0.8,
      "materiality": 0.65,
      "license_identifier": "CFTC-public-reporting",
      "usage_rights_identifier": "official-open-data.internal-analysis",
      "limitations": ["Weekly positioning data; not a real-time futures tape or complete physical inventory source."]
    },
    {
      "identifier": "nws-weather-alerts-live",
