    {
      "identifier": "sec-press-live",
      "source_name": "SEC press releases",
      "parser": "rss_atom",
      "endpoint": "https://www.sec.gov/news/pressreleases.rss",
      "source_type": "regulatory",
      "independence_group": "sec-press-office",
      "enabled": true,
      "required": true,
      "credential_environment_variables": ["SEC_USER_AGENT"],
      "user_agent_environment_variable": "SEC_USER_AGENT",
      "parameters": {},
      "headers": {"Accept": "application/rss+xml, application/xml;q=0.9"},
      "maximum_records": 100,
      "domains": ["current_events_news", "government_policy_regulation", "legal_litigation_sanctions", "filings_corporate_disclosures"],
