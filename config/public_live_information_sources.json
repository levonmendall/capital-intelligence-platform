      "maximum_records": 500,
      "domains": ["weather_climate_disasters", "commodity_physical_balances", "supply_chain_shipping_inventories", "energy_grid_power"],
      "impact_channels": ["supply", "demand", "commodity", "operational", "climate_weather"],
      "reliability": 0.99,
