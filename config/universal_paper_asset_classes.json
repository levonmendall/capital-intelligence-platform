    },
    {
      "asset_class": "future",
      "permitted_instrument_types": ["future", "perpetual"],
      "permitted_session_models": ["exchange_local"],
      "accounting_model": "fully_collateralized_notional",
      "external_provider_activation_required": true
    },
    {
      "asset_class": "option",
      "permitted_instrument_types": ["option"],
      "permitted_session_models": ["exchange_local"],
      "accounting_model": "long_premium_defined_risk",
