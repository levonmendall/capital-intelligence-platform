{
  "schema_version": "universal-paper-asset-class-scope.v1",
  "identifier": "universal-paper-asset-class-scope.v1",
  "objective": "Make every classified liquid public-market asset class mechanically available to the governed internal paper engine without creating live-order authority.",
  "operating_mode": "governed_internal_simulation",
  "portfolio_code": "COMPOUNDING",
  "base_currency": "USD",
  "long_only": true,
  "maximum_gross_leverage": 1.0,
  "real_money_authorized": false,
  "unclassified_assets_prohibited": true,
  "asset_classes": [
    {
      "asset_class": "us_equity",
      "permitted_instrument_types": ["common_stock", "preferred_stock"],
      "permitted_session_models": ["exchange_local"],
      "accounting_model": "cash_security",
      "external_provider_activation_required": true
    },
    {
      "asset_class": "us_etf",
      "permitted_instrument_types": ["fund"],
      "permitted_session_models": ["exchange_local"],
      "accounting_model": "cash_security",
      "external_provider_activation_required": true
    },
    {
      "asset_class": "cash_equivalent",
      "permitted_instrument_types": ["fund", "bond"],
      "permitted_session_models": ["exchange_local", "dealer_24_5"],
      "accounting_model": "cash_security",
      "external_provider_activation_required": true
    },
    {
      "asset_class": "fixed_income",
      "permitted_instrument_types": ["bond", "fund"],
      "permitted_session_models": ["dealer_24_5", "exchange_local"],
      "accounting_model": "cash_security",
      "external_provider_activation_required": true
    },
    {
      "asset_class": "international_equity",
      "permitted_instrument_types": ["common_stock", "preferred_stock", "fund"],
