  "limitations": [
    "Availability means governed internal paper simulation, not live brokerage routing.",
    "Direct FX and crypto remain unlevered spot only.",
    "Options remain long-premium and defined-risk only.",
    "Futures and volatility derivatives use a conservative fully collateralized notional model until certified margin accounting is active.",
    "Short sales, naked options, leverage above 1.0, private assets, and unclassified instruments remain prohibited.",
    "Provider-backed paper eligibility still requires current licensed data, runtime bindings, certifications, instrument approvals, and point-in-time evidence."
  ]
}
