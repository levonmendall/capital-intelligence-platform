      "permitted_instrument_types": ["spot", "fund", "future"],
      "permitted_session_models": ["exchange_local"],
      "accounting_model": "cash_backed_or_fully_collateralized_notional",
      "external_provider_activation_required": true
    },
    {
      "asset_class": "fx",
      "permitted_instrument_types": ["spot", "fund"],
      "permitted_session_models": ["continuous_24_5", "exchange_local"],
      "accounting_model": "unlevered_cash_spot",
      "external_provider_activation_required": true
    },
    {
      "asset_class": "crypto",
      "permitted_instrument_types": ["token", "spot", "stablecoin", "fund"],
      "permitted_session_models": ["continuous_24_7", "exchange_local"],
      "accounting_model": "unlevered_cash_spot",
      "external_provider_activation_required": true
    },
    {
      "asset_class": "real_estate",
      "permitted_instrument_types": ["common_stock", "preferred_stock", "fund"],
      "permitted_session_models": ["exchange_local"],
