{
  "schema_version": "capital-intelligence-runtime-topologies.v1",
  "commands": {
    "api": ["{python}", "-m", "uvicorn", "api.app:create_app", "--factory", "--host", "0.0.0.0", "--port", "8000", "--workers", "1", "--proxy-headers"],
    "backup": ["{python}", "run_backup.py", "--loop"],
    "backfill": ["{python}", "run_historical_backfill.py", "--loop"],
    "headlines": ["{python}", "run_public_headline_collector.py", "--loop"],
    "operator": ["{python}", "run_autonomous_paper_operator.py", "--loop"],
    "render": ["{python}", "run_render_service_workspace.py"],
    "ui": ["{python}", "-m", "streamlit", "run", "app.py", "--server.address=0.0.0.0", "--server.port=8501", "--server.headless=true"],
    "validate": ["{python}", "run_release_validation.py"]
  },
  "topologies": {
    "render": {
      "entry_command": "render",
      "processes": ["api", "cio-paper-operator", "public-headline-collector", "historical-backfill", "encrypted-backup", "streamlit", "composite-readiness-watchdog"],
      "paper_execution_default": "automatic",
      "persistent_state": "/app/database"
    },
    "docker-api": {
      "entry_command": "api",
      "processes": ["api"],
      "paper_execution_default": "disabled",
      "persistent_state": "/app/database"
    },
    "compose": {
      "entry_command": "docker compose up --build",
      "processes": ["api", "scheduler", "backfill", "backup", "web"],
      "paper_execution_default": "environment-explicit",
      "persistent_state": "capital_data"
    },
    "local": {
      "entry_command": "ui",
      "processes": ["streamlit"],
      "paper_execution_default": "disabled",
      "persistent_state": "database"
    },
    "ci": {
      "entry_command": "validate",
      "processes": ["validation"],
      "paper_execution_default": "disabled",
      "persistent_state": "temporary"
    }
  },
