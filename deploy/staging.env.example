CAPITAL_INTELLIGENCE_ENVIRONMENT=staging
CAPITAL_INTELLIGENCE_RELEASE=staging-local
CAPITAL_INTELLIGENCE_LOG_LEVEL=INFO
CAPITAL_INTELLIGENCE_JSON_LOGS=true
CAPITAL_INTELLIGENCE_ALLOWED_HOSTS=localhost,127.0.0.1,testserver
CAPITAL_INTELLIGENCE_ENFORCE_HTTPS=false
CAPITAL_INTELLIGENCE_AUTHENTICATION_REQUIRED=true
CAPITAL_INTELLIGENCE_BOOTSTRAP_ADMIN_EMAIL=admin@example.com
CAPITAL_INTELLIGENCE_BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-long-random-password
CAPITAL_INTELLIGENCE_METRICS_TOKEN=replace-with-at-least-24-random-characters
CAPITAL_INTELLIGENCE_REQUIRE_ENCRYPTED_BACKUPS=true
CAPITAL_INTELLIGENCE_BACKUP_ENCRYPTION_KEY=replace-with-a-valid-fernet-key
CAPITAL_INTELLIGENCE_BACKUP_DIRECTORY=backups
CAPITAL_INTELLIGENCE_BACKUP_RETENTION_DAYS=14
CAPITAL_INTELLIGENCE_BACKUP_INTERVAL_HOURS=24
CAPITAL_INTELLIGENCE_WORKER_MAX_AGE_SECONDS=180
CAPITAL_INTELLIGENCE_REQUIRE_OPERATIONAL_SLOS=false
CAPITAL_INTELLIGENCE_SECURITY_MASTER_DATABASE=database/security_master.db
CAPITAL_INTELLIGENCE_ELIGIBLE_UNIVERSE_DATABASE=database/eligible_universe.db
CAPITAL_INTELLIGENCE_FULL_UNIVERSE_SCREENING_DATABASE=database/full_universe_screening.db
CAPITAL_INTELLIGENCE_PRODUCTION_CONTEXT_DATABASE=database/production_context.db
CAPITAL_INTELLIGENCE_ASSET_SPECIFIC_EVIDENCE_DATABASE=database/asset_specific_evidence.db
CAPITAL_INTELLIGENCE_FORECAST_EVIDENCE_DATABASE=database/forecast_evidence.db
CAPITAL_INTELLIGENCE_FORECAST_SUPPORT_DATABASE=database/forecast_support.db
CAPITAL_INTELLIGENCE_ENVIRONMENT_DATABASE=database/environment_evidence.db
CAPITAL_INTELLIGENCE_REQUIRE_CANONICAL_ENVIRONMENT=false
CAPITAL_INTELLIGENCE_JOURNAL_DATABASE=database/institutional_journal.db
CAPITAL_INTELLIGENCE_CANONICAL_PORTFOLIO_DATABASE=database/canonical_portfolio.db
CAPITAL_INTELLIGENCE_MULTI_ASSET_EXECUTION_DATABASE=database/multi_asset_paper_execution.db
CAPITAL_INTELLIGENCE_ASSET_CLASS_GOVERNANCE_DATABASE=database/asset_class_governance.db
CAPITAL_INTELLIGENCE_MULTI_ASSET_EVALUATION_DATABASE=database/multi_asset_evaluation.db
CAPITAL_INTELLIGENCE_DAILY_OPERATION_DATABASE=database/canonical_daily_operations.db
CAPITAL_INTELLIGENCE_ALERT_DATABASE=database/alerts.db
CAPITAL_INTELLIGENCE_OPERATIONAL_SLO_DATABASE=database/operational_slos.db
CAPITAL_INTELLIGENCE_OPERATIONAL_INCIDENT_DATABASE=database/operational_incidents.db
CAPITAL_INTELLIGENCE_RESILIENCE_DATABASE=database/resilience_exercises.db
CAPITAL_INTELLIGENCE_PAPER_TEST_CAMPAIGN_DATABASE=database/paper_test_campaign.db
CAPITAL_INTELLIGENCE_PRODUCT_READINESS_EVIDENCE_DATABASE=database/product_readiness_evidence.db
CAPITAL_INTELLIGENCE_PRODUCT_TEST_READINESS_DATABASE=database/product_test_readiness.db
CAPITAL_INTELLIGENCE_SNAPSHOT_DATABASE=database/daily_intelligence_snapshots.db
CAPITAL_INTELLIGENCE_IDENTITY_DATABASE=database/identity.db
CAPITAL_INTELLIGENCE_CANONICAL_PORTFOLIO_CODE=COMPOUNDING
CAPITAL_INTELLIGENCE_INVESTMENT_PROCESS_VERSION=capital-intelligence-investment-process.v1
# Set only when this deployment is operating one immutable controlled-test baseline.
# CAPITAL_INTELLIGENCE_TEST_BASELINE_IDENTIFIER=test-baseline:multi-asset-alpha.1
# Optional controlled override; repository production context assembly is the default.
# CAPITAL_INTELLIGENCE_CANONICAL_CONTEXT_PROVIDER=module:function
# The repository ships the complete fenced 12-stage plan. Deployment supplies
# the reviewed provider/command binding secret for those stages.
CAPITAL_INTELLIGENCE_DAILY_OPERATION_PLAN=/app/deploy/canonical-daily-operations.json
CAPITAL_INTELLIGENCE_DAILY_STAGE_BINDINGS=/run/secrets/canonical-daily-stage-bindings.json
CAPITAL_INTELLIGENCE_DAILY_OPERATION_TIMEZONE=America/New_York
CAPITAL_INTELLIGENCE_DAILY_OPERATION_HOUR=7
CAPITAL_INTELLIGENCE_DAILY_OPERATION_POLL_SECONDS=60
CAPITAL_INTELLIGENCE_DAILY_LEASE_SECONDS=120
CAPITAL_INTELLIGENCE_DAILY_LEASE_HEARTBEAT_SECONDS=15
# Optional stable instance name. When omitted the worker uses hostname:pid.
# CAPITAL_INTELLIGENCE_DAILY_WORKER_IDENTIFIER=staging-scheduler-a
CAPITAL_INTELLIGENCE_SLO_PROVIDER_MAXIMUM_AGE_HOURS=36
CAPITAL_INTELLIGENCE_SLO_SCREENING_TIMEZONE=America/New_York
CAPITAL_INTELLIGENCE_SLO_SCREENING_HOUR=7
CAPITAL_INTELLIGENCE_SLO_SCREENING_DEADLINE_MINUTES=120
CAPITAL_INTELLIGENCE_SLO_THESIS_REVIEW_GRACE_HOURS=24
CAPITAL_INTELLIGENCE_SLO_EVALUATION_GRACE_HOURS=48
CAPITAL_INTELLIGENCE_MAX_REQUEST_BYTES=1048576
CAPITAL_INTELLIGENCE_RATE_LIMIT_REQUESTS=120
CAPITAL_INTELLIGENCE_RATE_LIMIT_WINDOW_SECONDS=60

# All-markets data-readiness manifest and official-source credentials.
CAPITAL_INTELLIGENCE_DATA_READINESS_MANIFEST=config/all_markets_data_readiness.json
FRED_API_KEY=inject-from-secret-manager
SEC_USER_AGENT=Capital Intelligence operations@example.com
# Select, license, implement, and certify these provider slots before enabling them in the manifest.
CAPITAL_INTELLIGENCE_GLOBAL_MACRO_PROVIDER=replace-with-provider-identifier
# CAPITAL_INTELLIGENCE_GLOBAL_MACRO_API_KEY=optional-provider-specific-secret
CAPITAL_INTELLIGENCE_GLOBAL_MARKET_DATA_PROVIDER=replace-with-provider-identifier
CAPITAL_INTELLIGENCE_GLOBAL_MARKET_DATA_API_KEY=inject-from-secret-manager
CAPITAL_INTELLIGENCE_GLOBAL_REFERENCE_DATA_PROVIDER=replace-with-provider-identifier
CAPITAL_INTELLIGENCE_GLOBAL_REFERENCE_DATA_API_KEY=inject-from-secret-manager
CAPITAL_INTELLIGENCE_GLOBAL_FUNDAMENTALS_PROVIDER=replace-with-provider-identifier
CAPITAL_INTELLIGENCE_GLOBAL_FUNDAMENTALS_API_KEY=inject-from-secret-manager
CAPITAL_INTELLIGENCE_FIXED_INCOME_DATA_PROVIDER=replace-with-provider-identifier
CAPITAL_INTELLIGENCE_FIXED_INCOME_DATA_API_KEY=inject-from-secret-manager
CAPITAL_INTELLIGENCE_CRYPTO_VALIDATION_PROVIDER=replace-with-provider-identifier
CAPITAL_INTELLIGENCE_CRYPTO_VALIDATION_API_KEY=inject-from-secret-manager
