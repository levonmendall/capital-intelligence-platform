CAPITAL_INTELLIGENCE_MARKET_INTELLIGENCE_API_KEY=inject-from-secret-manager
CAPITAL_INTELLIGENCE_OWNERSHIP_LENDING_PROVIDER=replace-with-provider-identifier
CAPITAL_INTELLIGENCE_OWNERSHIP_LENDING_API_KEY=inject-from-secret-manager

# Physical economy, weather, supply chains, and alternative activity.
