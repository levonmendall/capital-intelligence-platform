CAPITAL_INTELLIGENCE_PHYSICAL_SUPPLY_CHAIN_API_KEY=inject-from-secret-manager
CAPITAL_INTELLIGENCE_WEATHER_DISASTER_PROVIDER=replace-with-provider-identifier
CAPITAL_INTELLIGENCE_WEATHER_DISASTER_API_KEY=inject-from-secret-manager
CAPITAL_INTELLIGENCE_ALTERNATIVE_ACTIVITY_PROVIDER=replace-with-provider-identifier
CAPITAL_INTELLIGENCE_ALTERNATIVE_ACTIVITY_API_KEY=inject-from-secret-manager

# Crypto network, social/search, and innovation evidence.
CAPITAL_INTELLIGENCE_ONCHAIN_PROVIDER=replace-with-provider-identifier
CAPITAL_INTELLIGENCE_ONCHAIN_API_KEY=inject-from-secret-manager
