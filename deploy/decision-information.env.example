# Maximum decision-information readiness manifest.
CAPITAL_INTELLIGENCE_DECISION_INFORMATION_MANIFEST=config/maximum_decision_information_scope.json

# Official and original-source configuration.
CAPITAL_INTELLIGENCE_OFFICIAL_EVENTS_SOURCE_CONFIG=/run/secrets/official-events-sources.json
CAPITAL_INTELLIGENCE_OFFICIAL_MARKET_STATISTICS_CONFIG=/run/secrets/official-market-statistics.json
SEC_USER_AGENT=Capital Intelligence operations@example.com

# Licensed global current-events and news coverage.
CAPITAL_INTELLIGENCE_GLOBAL_NEWS_PROVIDER=replace-with-provider-identifier
CAPITAL_INTELLIGENCE_GLOBAL_NEWS_API_KEY=inject-from-secret-manager
CAPITAL_INTELLIGENCE_JOURNALISM_PROVIDER=replace-with-independent-provider-identifier
CAPITAL_INTELLIGENCE_JOURNALISM_API_KEY=inject-from-secret-manager

# Issuer disclosures, transcripts, guidance, and estimates.
CAPITAL_INTELLIGENCE_ISSUER_DISCLOSURE_PROVIDER=replace-with-provider-identifier
CAPITAL_INTELLIGENCE_ISSUER_DISCLOSURE_API_KEY=inject-from-secret-manager
CAPITAL_INTELLIGENCE_TRANSCRIPTS_ESTIMATES_PROVIDER=replace-with-provider-identifier
CAPITAL_INTELLIGENCE_TRANSCRIPTS_ESTIMATES_API_KEY=inject-from-secret-manager

# Derivatives, positioning, ownership, credit, and lending.
CAPITAL_INTELLIGENCE_DERIVATIVES_POSITIONING_PROVIDER=replace-with-provider-identifier
CAPITAL_INTELLIGENCE_DERIVATIVES_POSITIONING_API_KEY=inject-from-secret-manager
