CAPITAL_INTELLIGENCE_ENVIRONMENT=production
CAPITAL_INTELLIGENCE_RELEASE=replace-with-deployed-commit-sha
CAPITAL_INTELLIGENCE_LOG_LEVEL=INFO
CAPITAL_INTELLIGENCE_JSON_LOGS=true
CAPITAL_INTELLIGENCE_ALLOWED_HOSTS=api.example.com,app.example.com
CAPITAL_INTELLIGENCE_ENFORCE_HTTPS=true
CAPITAL_INTELLIGENCE_AUTHENTICATION_REQUIRED=true
CAPITAL_INTELLIGENCE_BOOTSTRAP_ADMIN_EMAIL=admin@example.com
CAPITAL_INTELLIGENCE_BOOTSTRAP_ADMIN_PASSWORD=inject-from-secret-manager
CAPITAL_INTELLIGENCE_METRICS_TOKEN=inject-at-least-24-random-characters
CAPITAL_INTELLIGENCE_REQUIRE_ENCRYPTED_BACKUPS=true
CAPITAL_INTELLIGENCE_BACKUP_ENCRYPTION_KEY=inject-valid-fernet-key-from-secret-manager
CAPITAL_INTELLIGENCE_BACKUP_RETENTION_DAYS=30
CAPITAL_INTELLIGENCE_BACKUP_INTERVAL_HOURS=24
CAPITAL_INTELLIGENCE_WORKER_MAX_AGE_SECONDS=180
CAPITAL_INTELLIGENCE_MAX_REQUEST_BYTES=1048576
CAPITAL_INTELLIGENCE_RATE_LIMIT_REQUESTS=120
CAPITAL_INTELLIGENCE_RATE_LIMIT_WINDOW_SECONDS=60
CAPITAL_INTELLIGENCE_REQUIRE_JOURNAL=true
CAPITAL_INTELLIGENCE_REQUIRE_LIVE_PROVIDER=true
CAPITAL_INTELLIGENCE_ALLOWED_ORIGINS=https://app.example.com
