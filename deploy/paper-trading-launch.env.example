# Exact controlled paper-test identity
CAPITAL_INTELLIGENCE_TEST_BASELINE_IDENTIFIER=test-baseline:replace-with-immutable-baseline
CAPITAL_INTELLIGENCE_INVESTMENT_PROCESS_VERSION=capital-intelligence-investment-process.v1
CAPITAL_INTELLIGENCE_RELEASE=replace-with-tested-commit-sha
CAPITAL_INTELLIGENCE_ENVIRONMENT=production

# Independent append-only authorities required by execution
# The paper-test governance database also stores exact authenticated user consent
# for each proposed paper implementation.
CAPITAL_INTELLIGENCE_PAPER_TEST_GOVERNANCE_DATABASE=database/paper_test_governance.db
CAPITAL_INTELLIGENCE_PAPER_LAUNCH_DATABASE=database/paper_trading_launch.db
CAPITAL_INTELLIGENCE_PAPER_CONTROL_DATABASE=database/paper_trading_control.db

# Production and staging refuse the explicit local-development bypass.
# Use run_approved_paper_execution.py as the user-consent-gated entrypoint.
