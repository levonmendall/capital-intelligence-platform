# Governed free supporting providers.
CAPITAL_INTELLIGENCE_FREE_PROVIDER_CATALOG=config/free_provider_connections.json
CAPITAL_INTELLIGENCE_FREE_PROVIDER_DATABASE=database/free_provider_connections.db
CAPITAL_INTELLIGENCE_CRYPTO_VENUE_BINDINGS=config/crypto_venue_bindings.free.json

# Official public evidence sources. These values are free but user-specific.
FRED_API_KEY=inject-from-secret-manager
SEC_USER_AGENT=Capital Intelligence operations@example.com

# Optional free OpenFIGI key for higher request limits. Anonymous access remains enabled.
# OPENFIGI_API_KEY=inject-from-secret-manager

# Initial broad multi-asset evidence provider.
CAPITAL_INTELLIGENCE_EODHD_API_TOKEN=inject-from-secret-manager
CAPITAL_INTELLIGENCE_EODHD_BINDINGS=/run/secrets/eodhd-instrument-bindings.json

# Survivorship-safe historical reference and corporate-action provider.
CAPITAL_INTELLIGENCE_GLOBAL_REFERENCE_DATA_PROVIDER=replace-with-provider-identifier
CAPITAL_INTELLIGENCE_GLOBAL_REFERENCE_DATA_API_KEY=inject-from-secret-manager

# Execution-grade non-crypto market quotes.
CAPITAL_INTELLIGENCE_GLOBAL_MARKET_DATA_PROVIDER=replace-with-provider-identifier
CAPITAL_INTELLIGENCE_GLOBAL_MARKET_DATA_API_KEY=inject-from-secret-manager

# Global fundamentals and filing normalization.
CAPITAL_INTELLIGENCE_GLOBAL_FUNDAMENTALS_PROVIDER=replace-with-provider-identifier
CAPITAL_INTELLIGENCE_GLOBAL_FUNDAMENTALS_API_KEY=inject-from-secret-manager

# Evaluated fixed-income pricing and terms.
CAPITAL_INTELLIGENCE_FIXED_INCOME_DATA_PROVIDER=replace-with-provider-identifier
CAPITAL_INTELLIGENCE_FIXED_INCOME_DATA_API_KEY=inject-from-secret-manager

# Additional global macro and independent crypto validation slots.
CAPITAL_INTELLIGENCE_GLOBAL_MACRO_PROVIDER=replace-with-provider-configuration
CAPITAL_INTELLIGENCE_CRYPTO_VALIDATION_PROVIDER=replace-with-provider-identifier
CAPITAL_INTELLIGENCE_CRYPTO_VALIDATION_API_KEY=inject-from-secret-manager

# Immutable provider-native historical landing zone.
CAPITAL_INTELLIGENCE_PROVIDER_BACKFILL_DIRECTORY=data/provider-backfills

# The checked-in all-markets manifest remains fail closed until licensing,
# storage, derived-analytics, paper-simulation, SLA, point-in-time, and provider
# certification facts have been reviewed and recorded. Free connectivity does not
# satisfy those institutional data-readiness requirements by itself.
CAPITAL_INTELLIGENCE_DATA_READINESS_MANIFEST=config/all_markets_data_readiness.json

# Provider-neutral runtime connector and append-only activation authorities.
# Credentials remain environment-injected. Licensing, certification, permitted
# uses, effective dates, and expiration exist only in the activation registries.
CAPITAL_INTELLIGENCE_CONFIGURED_DATASET_PROVIDER=/run/secrets/configured-dataset-provider.json
CAPITAL_INTELLIGENCE_PROVIDER_ACTIVATION_DATABASE=database/provider_activations.db
CAPITAL_INTELLIGENCE_DECISION_INFORMATION_ACTIVATION_DATABASE=database/decision_information_activations.db
CAPITAL_INTELLIGENCE_DECISION_INFORMATION_DATASET_BINDING=/run/secrets/decision-information-binding.json
CAPITAL_INTELLIGENCE_ASSET_CLASS_GOVERNANCE_DATABASE=database/asset_class_governance.db
CAPITAL_INTELLIGENCE_SECURITY_MASTER_DATASET_BINDING=/run/secrets/global-reference-data-binding.json
CAPITAL_INTELLIGENCE_UNIVERSE_METRICS_DATASET_BINDING=/run/secrets/global-market-data-binding.json
CAPITAL_INTELLIGENCE_CANDIDATE_SCREENING_DATASET_BINDING=/run/secrets/candidate-screening-binding.json
