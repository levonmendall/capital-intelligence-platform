# Official public evidence sources.
FRED_API_KEY=inject-from-secret-manager
SEC_USER_AGENT=Capital Intelligence operations@example.com

# Initial broad multi-asset evidence provider.
CAPITAL_INTELLIGENCE_EODHD_API_TOKEN=inject-from-secret-manager
CAPITAL_INTELLIGENCE_EODHD_BINDINGS=/run/secrets/eodhd-instrument-bindings.json

# Independent venue-specific crypto market-data validation.
CAPITAL_INTELLIGENCE_CRYPTO_VENUE_BINDINGS=/run/secrets/crypto-venue-bindings.json

# Immutable provider-native historical landing zone.
CAPITAL_INTELLIGENCE_PROVIDER_BACKFILL_DIRECTORY=data/provider-backfills

# The checked-in all-markets manifest remains fail closed until licensing,
# storage, derived-analytics, paper-simulation, SLA, point-in-time, and provider
# certification facts have been reviewed and recorded.
CAPITAL_INTELLIGENCE_DATA_READINESS_MANIFEST=config/all_markets_data_readiness.json
